BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_DB_PATH=auth.db
BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor

# Google OAuth: http://localhost:3000/api/auth/callback/google
# GitHub OAuth: http://localhost:3000/api/auth/callback/github
# Add the matching client ID and secret from each provider console in .env.local.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
